rules_version = '2';

// Luqma — Cloud Storage rules.
//
// Two areas with opposite rules. Raw uploads are write-only: a phone puts a file there
// and never reads that area again. Processed derivatives are read-only: the functions
// write them, nobody else does.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Where a phone drops an original. Nothing reads from here except the function that
    // processes it, which runs with admin credentials and is not subject to these rules.
    match /uploads/{kind}/{uid}/{fileName} {
      allow read: if isAdmin();
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }

    // Processed WebP derivatives. Publicly readable so images cache normally on a weak
    // connection, which is the whole point of generating them.
    //
    // Worth being precise about what this does and does not protect: a pending image is
    // not discoverable, because its `media` document — the only place its path appears —
    // is unreadable until an admin approves it. Someone who already had the exact URL
    // could still fetch it. That is an accepted trade: the gate exists to keep unreviewed
    // photos out of the storefront, not to keep a secret.
    match /media/{mediaId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
