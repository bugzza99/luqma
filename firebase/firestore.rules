rules_version = '2';

// Luqma — Firestore security rules.
//
// These are the real boundary. Everything the apps enforce, a modified client can
// ignore; only what is written here actually holds. Read `firebase/test/` alongside this
// file — every rule below exists because a test says what happens without it.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- identity
    function signedIn() {
      return request.auth != null;
    }

    // Admin is a custom claim set by a Cloud Function, never a field in a document a
    // client can reach. A role stored in Firestore is a role a client can try to write.
    // `get` with a default, not a bare lookup: on a token that carries no custom claims
    // at all — every customer — a bare `token.admin` *errors* rather than reading false,
    // which fails the branch it is in for a reason that has nothing to do with access.
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Merchant staff carry their merchantId as a claim, so ownership is decided without
    // a second read on every single request.
    //
    // "Belongs to" is not "runs". An owner and their courier carry the SAME merchantId,
    // so this alone cannot tell them apart — and a rule written on it alone would let a
    // courier accept orders, rewrite the menu and close the shop. Everything that acts
    // for a merchant uses isMerchantOwner below; this is only the shared half.
    function ownsMerchant(merchantId) {
      return signedIn() && request.auth.token.merchantId == merchantId;
    }

    // `get` with a default rather than a bare lookup: a token without the claim is an
    // ordinary customer, not an error, and a missing key would otherwise fail the whole
    // evaluation rather than the one branch.
    function staffRole() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function staffScope() {
      return signedIn() ? request.auth.token.get('scope', '') : '';
    }

    function isMerchantOwner(merchantId) {
      return ownsMerchant(merchantId) && staffRole() == 'owner';
    }

    function isCourierFor(merchantId) {
      return ownsMerchant(merchantId) && staffRole() == 'courier';
    }

    // Luqma's own courier: home kitchens, and merchants that do not deliver. Belongs to
    // no merchant, so it is scope rather than merchantId that identifies them.
    function isPlatformCourier() {
      return staffRole() == 'courier' && staffScope() == 'platform';
    }

    // The set of fields this write actually changes.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(allowed) {
      return changed().hasOnly(allowed);
    }

    // The delivery fee bounds, mirrored from Remote Config. Clamping only in the app
    // would leave the real limit to whoever is holding the phone.
    function feeWithinRange(fee) {
      return fee == 0 || (fee >= 500 && fee <= 2000);
    }

    // ------------------------------------------------ the order state machine
    // Mirrored from `OrderTransitions` in luqma_core. That copy hides a button; this
    // one is what actually holds — a modified client ignores the first and not this.
    //
    // It exists because `delivered` is the transition `onOrderDelivered` fires on, and
    // that function spends a prepaid wallet or accrues a commission. Whoever can write
    // the word can move the money.
    function movingStatus() {
      return 'status' in changed();
    }

    function wasStatus() { return resource.data.status; }
    function nowStatus() { return request.resource.data.status; }

    function merchantMayMove() {
      return (wasStatus() == 'placed'
                && (nowStatus() == 'accepted' || nowStatus() == 'cancelled'))
          || (wasStatus() == 'accepted'
                && (nowStatus() == 'preparing' || nowStatus() == 'cancelled'))
          || (wasStatus() == 'preparing' && nowStatus() == 'outForDelivery');
    }

    // A courier never accepts an order, and never marks one delivered that nobody cooked.
    function courierMayMove() {
      return (wasStatus() == 'preparing' && nowStatus() == 'outForDelivery')
          || (wasStatus() == 'outForDelivery'
                && (nowStatus() == 'delivered' || nowStatus() == 'cancelled'));
    }

    // A rating or a complaint has to be about an order this person actually had, from
    // the merchant they are naming. Without it a merchant's average — and their
    // complaint queue — is anybody's to fill, from anywhere, for nothing.
    function theirOrder(orderId) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return order.customerUid == request.auth.uid
          && order.merchantId == request.resource.data.merchantId;
    }

    function theirDeliveredOrder(orderId) {
      return theirOrder(orderId)
          && get(/databases/$(database)/documents/orders/$(orderId)).data.status
             == 'delivered';
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid);

      // A customer owns their name, phone and addresses. They do not own the fields
      // that describe how the platform sees them — unblocking yourself or resetting
      // your own refusal count would make the whole abuse defence decorative.
      allow update: if isAdmin() || (
        isUser(uid) &&
        onlyChanges(['name', 'phone', 'fcmTokens', 'defaultAddressId', 'updatedAt'])
      );
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, write: if isUser(uid) || isAdmin();
      }
    }

    // ---------------------------------------------------------------- merchants
    match /merchants/{merchantId} {
      allow read: if resource.data.status == 'approved'
                  || ownsMerchant(merchantId)
                  || isAdmin();

      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        isMerchantOwner(merchantId) &&
        // Everything not in this list — status, planId, revenueModel, walletBalance,
        // servedZones, ratingAvg, ownerUid — belongs to the admin. A merchant that can
        // set its own revenue model sets its own price.
        onlyChanges([
          'name', 'phone', 'logoMediaId', 'coverMediaId', 'openingHours',
          'pausedUntil', 'menuCategories', 'minOrder', 'deliveryFeeOverride', 'updatedAt'
        ]) &&
        (!('deliveryFeeOverride' in changed())
          || feeWithinRange(request.resource.data.deliveryFeeOverride))
      );
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create: if isAdmin() || isMerchantOwner(request.resource.data.merchantId);

      // On an update the owner is the one already on the document, and the item cannot
      // change hands. Judging the *incoming* merchantId let one merchant rewrite
      // another shop's dish into their own menu.
      allow update: if isAdmin() || (
        isMerchantOwner(resource.data.merchantId) &&
        request.resource.data.merchantId == resource.data.merchantId
      );

      // A delete carries no incoming document at all, so it can only be judged on the
      // one already there. Written as a single `write` this refused every merchant and
      // let only the admin through — a menu nobody could take a dish out of.
      allow delete: if isAdmin() || isMerchantOwner(resource.data.merchantId);
    }

    match /dailyMeals/{mealId} {
      allow read: if true;
      // remainingQty moves only through a Cloud Function, so a customer cannot reserve
      // a portion by writing the number down themselves.
      allow create: if isAdmin() || isMerchantOwner(request.resource.data.merchantId);
      // Judged on the document already there: a delete carries no incoming one.
      allow delete: if isAdmin() || isMerchantOwner(resource.data.merchantId);
      // Neither quantity moves from a client. `remainingQty` is the server's, decremented
      // in a transaction; and letting a kitchen raise `totalQty` alone would only skew
      // the meter, since they cannot raise what is left to match it.
      allow update: if isAdmin() || (
        isMerchantOwner(resource.data.merchantId) &&
        !('remainingQty' in changed()) &&
        !('totalQty' in changed())
      );
    }

    // ---------------------------------------------------------------- media
    // One collection for every image in the product, so the moderation gate has exactly
    // one door. An image is invisible until an admin has looked at it.
    match /media/{mediaId} {
      allow read: if resource.data.status == 'approved'
                  || isAdmin()
                  || isUser(resource.data.uploadedBy);

      // `uploadedBy` is checked, not trusted: it is what the read rule above lets the
      // uploader see, so filing an upload under another name hands it to that person.
      allow create: if signedIn()
                    && request.resource.data.status == 'pending'
                    && isUser(request.resource.data.uploadedBy);

      // Only an admin moves an image out of pending. An uploader approving their own
      // upload is the gate with a hole in it.
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------- orders
    match /orders/{orderId} {
      // A courier reads their merchant's orders too — they carry the same merchantId,
      // and they have to see what is ready before they can pick it up.
      allow read: if isAdmin()
                  || isUser(resource.data.customerUid)
                  || ownsMerchant(resource.data.merchantId)
                  || isUser(resource.data.courierUid)
                  // Without this the platform courier cannot find the work at all: they
                  // are not named on an order until they take it, and they cannot take
                  // what they cannot see.
                  || (isPlatformCourier()
                      && resource.data.deliveryBy == 'platform');

      // Orders are created by a Cloud Function, which is what recomputes the total and
      // the coupon. A client-written order is a client-chosen price.
      allow create: if false;

      allow update: if isAdmin() || (
        isMerchantOwner(resource.data.merchantId) &&
        // `courierUid` is deliberately absent. Only a courier ever writes it, and only
        // their own name — a merchant able to write it could hand any account on the
        // platform read and write over an order, and the cash on it.
        onlyChanges(['status', 'prepMinutes', 'cancelReason', 'cancelledBy',
                     'statusHistory', 'updatedAt']) &&
        (!movingStatus() || merchantMayMove())
      ) || (
        isUser(resource.data.customerUid) &&
        resource.data.status == 'placed' &&
        request.resource.data.status == 'cancelled' &&
        onlyChanges(['status', 'cancelReason', 'cancelledBy', 'statusHistory', 'updatedAt'])
      ) || (
        // A courier taking an order out, delivering it, or reporting that it failed.
        // `deliveredAt` is here because it is what the revenue engine keys off, and
        // `cancelReason` because a failed delivery with no reason tells nobody anything.
        // Once an order names a courier, only that courier may move it. Whoever marks
        // it delivered is saying the cash changed hands, and in a shop with two riders
        // that has to be the one holding the bag.
        (('courierUid' in resource.data)
          ? isUser(resource.data.courierUid)
          : (isCourierFor(resource.data.merchantId)
             || (isPlatformCourier() && resource.data.deliveryBy == 'platform'))) &&
        onlyChanges(['status', 'statusHistory', 'courierUid', 'deliveredAt',
                     'cancelReason', 'cancelledBy', 'updatedAt']) &&
        (!movingStatus() || courierMayMove()) &&
        // A courier may only ever write their own name, and only onto an order nobody
        // else is already carrying. Otherwise one could hand another's phone a delivery,
        // or take an order off somebody halfway to the door.
        (!('courierUid' in changed())
          || (request.resource.data.courierUid == request.auth.uid
              && (!('courierUid' in resource.data)
                  || resource.data.courierUid == request.auth.uid)))
      );

      allow delete: if false;
    }

    match /orderIssues/{issueId} {
      allow read: if isAdmin()
                  || isUser(resource.data.customerUid)
                  || ownsMerchant(resource.data.merchantId);
      allow create: if isUser(request.resource.data.customerUid)
                    && theirOrder(request.resource.data.orderId);
      allow update, delete: if isAdmin();
    }

    // Keyed by the order on purpose: one customer holds exactly one rating per order, so
    // rating again corrects the first instead of moving the average a second time.
    match /ratings/{orderId} {
      // Stars aggregate onto the merchant; the comment stays between the customer, the
      // merchant and the admin until the public-comments flag is turned on.
      allow read: if isAdmin()
                  || isUser(resource.data.customerUid)
                  || ownsMerchant(resource.data.merchantId);
      allow create, update: if isAdmin() || (
        isUser(request.resource.data.customerUid) &&
        request.resource.data.orderId == orderId &&
        theirDeliveredOrder(orderId)
      );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- coupons
    // Deliberately unreadable by clients. A readable coupons collection is one anybody
    // can enumerate — every merchant-specific code and every campaign that has not
    // launched yet. The app never sees a coupon document; it calls a function that
    // returns the discount for one basket and nothing else.
    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }

    match /couponRedemptions/{redemptionId} {
      allow read: if isAdmin();
      // Written by the Cloud Function that accepts the order, so per-user limits cannot
      // be sidestepped by simply not recording the use.
      allow write: if false;
    }

    // ---------------------------------------------------------------- staff
    match /staff/{uid} {
      allow read: if isAdmin()
                  || isUser(uid)
                  || ownsMerchant(resource.data.merchantId);
      // Accounts are created by a Cloud Function that verifies a merchant owner can only
      // ever create a courier scoped to their own merchant.
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- money
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || ownsMerchant(resource.data.merchantId);
      allow write: if isAdmin();
    }

    match /promotions/{promotionId} {
      // Both live states, because that is what the app queries for. Firestore refuses a
      // whole query it cannot prove is limited to readable documents, so allowing less
      // than `watchLive` asks for returned nothing at all rather than returning less.
      allow read: if resource.data.status in ['approved', 'active']
                  || isAdmin()
                  || ownsMerchant(resource.data.merchantId);
      // A merchant may ask for a placement; only an admin may approve one, which is what
      // keeps unmoderated push off every customer's phone.
      allow create: if isAdmin() || (
        ownsMerchant(request.resource.data.merchantId) &&
        request.resource.data.status == 'requested'
      );
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------- control plane
    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homeSections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /landmarks/{landmarkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- audit
    // Append-only, including for admins. A log its own subject can edit proves nothing.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Anything not named above is closed. New collections start denied and are opened
    // deliberately, rather than shipping open because nobody remembered them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
