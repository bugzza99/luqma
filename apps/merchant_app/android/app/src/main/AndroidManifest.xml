<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared here rather than relied on. The release build was getting INTERNET only
         because some dependency's own manifest happened to declare it and the merger
         unions them — `merchant_app` from `firebase_messaging`, the other two from a
         transitive Android library neither app names. That is a network stack held up by
         a package nobody chose for the purpose: drop or swap that dependency and three
         apps that talk to nothing but Supabase silently lose the ability to open a
         socket, in release only, where it is hardest to notice. Flutter's template puts
         this in the debug and profile manifests alone, which is why `flutter run` never
         showed it. -->
    <uses-permission android:name="android.permission.INTERNET"/>


    <!-- A new order has to reach a merchant who is not looking at the phone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wakes the screen and shows the order over the lock screen, so somebody in a
         kitchen does not have to unlock anything to see what came in. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Battery optimisation kills the connection this app exists for. The prompt is
         part of onboarding a merchant, not something to ask for at random. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The orders channel itself is created in MainActivity, which is what gives it
             the importance and the sound a missed order cannot afford to lose.

             There is no <meta-data> naming it here on purpose. Those two entries were
             Firebase Messaging' default-channel and default-icon keys, and the S6
             cutover removed their android:name along with Firebase — leaving two
             elements with a value and no name, which Android refuses outright. When push
             is wired to whatever service replaces FCM, its own keys come back here. -->
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
