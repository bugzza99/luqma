# Dependencies — restored by `flutter pub get` and `npm install`.
node_modules/
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# Compiled TypeScript. `npm --prefix functions run build` regenerates it.
functions/lib/

# Generated Dart. Regenerated by build_runner and gen-l10n, so committing it would mean
# reviewing thousands of lines nobody wrote and resolving conflicts in them.
#   dart run build_runner build --delete-conflicting-outputs
#   flutter gen-l10n
*.g.dart
*.freezed.dart
packages/luqma_core/lib/src/l10n/app_localizations*.dart

# Firebase CLI working files and emulator output.
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# Knowledge graph working files. The three outputs below are kept; the rest is a cache
# and a manifest that only mean anything on the machine that built them.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_*

# Editors and OS.
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Built APKs handed to the owner for testing. Rebuilt on demand, never reviewed.
apks/

# Non-shippable release-mode APKs produced by the CI smoke build.
build/ci-apks/

# Service account keys. A full key to the project — never in the repository, whatever
# it is named or wherever it is dropped.
*firebase-adminsdk*.json
serviceAccount*.json

# The release keystore and its passwords. Losing this file loses the Play Store
# listing; leaking it loses the store listing to whoever else has it.
signing/*.jks
signing/key.properties

# JVM heap dumps. Gradle writes one of these when it runs out of memory, and four of them
# — 3 GB in total — were committed and sat in the history until the first attempt to push
# anywhere. GitHub refuses a single file over 100 MB, so they would have blocked it.
*.hprof
